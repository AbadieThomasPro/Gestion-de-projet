# Build
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY backend/package.json backend/
COPY frontend/package.json frontend/
# The Prisma schema is needed by "prisma generate" (postinstall)
COPY backend/prisma backend/prisma
COPY backend/prisma.config.js backend/
RUN npm ci -w backend
COPY backend backend
RUN npm run build -w backend

# Run (only production dependencies)
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
COPY backend/package.json backend/
COPY frontend/package.json frontend/
# Schema and migrations: client generated by postinstall, migrations applied at startup
COPY backend/prisma backend/prisma
COPY backend/prisma.config.js backend/
RUN npm ci -w backend --omit=dev
COPY backend/next.config.mjs backend/
COPY backend/lib backend/lib
COPY --from=build /app/backend/.next backend/.next
EXPOSE 3001
CMD ["sh", "-c", "npm run db:migrate -w backend && npm start -w backend"]
